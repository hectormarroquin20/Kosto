---
// @ts-ignore
import "/src/styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<!-- <body class="bg-slate-50 text-slate-900 antialiased"> -->
	<body
		class="min-h-screen bg-gradient-to-br from-indigo-400 via-slate-50 to-slate-400 text-slate-900 antialiased flex flex-col min-h-screen"
	>
		<header
			class="sticky top-0 z-50 bg-white/70 backdrop-blur-lg border-b border-indigo-200/50 shadow-sm"
		>
			<nav
				class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between"
			>
				<a
					href="/"
					class="text-xl font-bold text-indigo-700 tracking-tight"
					>Insummi</a
				>

				<div
					class="flex items-center gap-8 text-sm font-medium text-slate-600"
				>
					<a
						href="/about"
						class="hover:text-indigo-600 transition-colors"
						>Acerca de</a
					>
					<a
						href="/privacy"
						class="hover:text-indigo-600 transition-colors"
						>Privacidad</a
					>
					<a
						href="/contact"
						class="hover:text-indigo-600 transition-colors"
						>Contacto</a
					>

					<div class="h-4 w-px bg-slate-300"></div>

					<a
						href="https://app.insummi.com"
						class="text-indigo-600 font-semibold border border-indigo-200 hover:bg-indigo-50 transition-colors px-4 py-2 rounded-lg"
					>
						Iniciar Sesión
					</a>
				</div>
			</nav>
		</header>

		<main class="flex-grow w-full">
			<slot />
		</main>

		<footer class="bg-white border-t border-slate-200 py-12 mt-auto">
			<div
				class="max-w-7xl mx-auto px-4 text-center text-sm text-slate-500"
			>
				<div class="flex justify-center gap-6 mb-4">
					<a href="/privacy" class="hover:text-indigo-600"
						>Política de Privacidad</a
					>
					<a href="/about" class="hover:text-indigo-600">Acerca de</a>
					<a href="/contact" class="hover:text-indigo-600">Contacto</a
					>
				</div>
				<p>© 2026 Insummi. Todos los derechos reservados.</p>
			</div>
		</footer>
	</body>
</html>
