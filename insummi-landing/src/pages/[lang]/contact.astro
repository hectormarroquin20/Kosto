---
import { useTranslations } from "../../i18n/utils";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'es' | 'en');
---

<Layout title={t('contact.title')}>
    <main class="max-w-2xl mx-auto px-6 py-16">
        <!-- Encabezado -->
        <h1
            class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-6 tracking-tight"
        >
            {t('contact.h1')}
        </h1>

        <div class="space-y-8 text-slate-700 leading-relaxed mb-12">
            <h2 class="text-2xl font-semibold text-indigo-900">
                {t('contact.subtitle')}
            </h2>
            <p class="text-lg">
                {t('contact.p1')}
            </p>
            <p>
                {t('contact.p2')}
            </p>

            <!-- Bloque de contacto directo -->
            <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-6">
                <h3 class="font-bold text-indigo-900 mb-2">
                    {t('contact.box.title')}
                </h3>
                <p>
                    {t('contact.box.text').split('admin@insummi.com')[0]}<a
                        href="mailto:admin@insummi.com"
                        class="text-indigo-600 font-semibold hover:underline"
                        >admin@insummi.com</a
                    >{t('contact.box.text').split('admin@insummi.com')[1]}
                </p>
            </div>
        </div>

        <hr class="border-slate-200 mb-12" />

        <!-- Formulario Moderno -->
        <div
            class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-100 p-8"
        >
            <h2 class="text-2xl font-bold text-slate-900 mb-6">
                {t('contact.form.title')}
            </h2>

            <form class="flex flex-col gap-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex flex-col gap-2">
                        <label
                            class="text-sm font-semibold text-slate-700"
                            for="name">{t('contact.form.name')}</label
                        >
                        <input
                            type="text"
                            id="name"
                            name="name"
                            required
                            class="px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all"
                        />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label
                            class="text-sm font-semibold text-slate-700"
                            for="email">{t('contact.form.email')}</label
                        >
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            class="px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all"
                        />
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label
                        class="text-sm font-semibold text-slate-700"
                        for="message">{t('contact.form.message')}</label
                    >
                    <textarea
                        id="message"
                        name="message"
                        required
                        rows="5"
                        class="px-4 py-3 rounded-lg border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all"
                    ></textarea>
                </div>

                <button
                    type="submit"
                    class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-4 rounded-xl shadow-lg shadow-indigo-600/30 transition-all duration-300"
                >
                    {t('contact.form.button')}
                </button>
            </form>
        </div>
    </main>
</Layout>
