---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
    return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as "es" | "en");
---

<Layout title="Insummi">
    <div
        class="min-h-screen bg-gradient-to-b from-indigo-50/60 via-white to-slate-50"
    >
        <section
            class="max-w-7xl mx-auto px-4 py-24 md:py-32 text-center flex flex-col items-center"
        >
            <div
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-100 text-indigo-700 text-sm font-medium mb-8"
            >
                {t("index.hero.badge")}
            </div>

            <h1
                class="text-5xl md:text-6xl p-2 font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-indigo-800 to-slate-900 mb-6 max-w-4xl"
            >
                {t("index.hero.title")}
            </h1>

            <p
                class="text-lg md:text-xl p-2 text-slate-600 max-w-2xl mb-10 leading-relaxed"
            >
                {t("index.hero.subtitle")}
            </p>

            <a
                href="https://app.insummi.com/register"
                class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white shadow-lg shadow-indigo-600/30 transition-all duration-300 rounded-xl px-8 py-4 font-semibold text-lg"
            >
                {t("index.hero.button")}
            </a>
        </section>
    </div>
</Layout>
