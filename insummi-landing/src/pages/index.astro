---
// @ts-ignore
import "/src/styles/global.css";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Insummi - Control de costos operativos">
    <div
        class="min-h-screen bg-gradient-to-b from-indigo-50/60 via-white to-slate-50"
    >
        <section
            class="max-w-7xl mx-auto px-4 py-24 md:py-32 text-center flex flex-col items-center"
        >
            <div
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-100 text-indigo-700 text-sm font-medium mb-8"
            >
                🚀 Versión Web Disponible <span class="text-indigo-300">|</span> 📱
                App Móvil Próximamente
            </div>

            <h1
                class="text-5xl md:text-6xl p-2 font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-slate-900 via-indigo-800 to-slate-900 mb-6 max-w-4xl"
            >
                Controla tus costos. Automatiza tus recetas. Haz crecer tu
                negocio.
            </h1>

            <p
                class="text-lg md:text-xl p-2 text-slate-600 max-w-2xl mb-10 leading-relaxed"
            >
                La plataforma que calcula tus costos operativos, gestiona tu
                inventario y protege tus márgenes de ganancia sin depender de
                hojas de cálculo complejas.
            </p>

            <a
                href="https://app.insummi.com"
                class="inline-block bg-indigo-600 hover:bg-indigo-700 hover:scale-150 text-white shadow-lg shadow-indigo-600/30 transition-all duration-300 rounded-xl px-8 py-4 font-semibold text-lg"
            >
                Comenzar gratis
            </a>
        </section>

        <div class="max-w-4xl mx-auto px-4 mb-20">
            <div
                class="h-24 bg-slate-200 border-2 border-dashed border-slate-300 flex items-center justify-center text-slate-400 text-sm rounded-lg"
            >
                [ Espacio Reservado para Anuncio AdSense - 728x90 ]
            </div>
        </div>
    </div></Layout
>
