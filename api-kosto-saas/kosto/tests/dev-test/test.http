{
    "name": "Cacao en Polvo",
    "unit_of_measure": "g",
    "unit_cost": 0.01,
    "current_stock": 1000
}


### ==========================================
### FASE 2: ARMAR LA RECETA DEL PASTEL
### (Sustituye los IDs por los que copiaste)
### ==========================================

### Agregar Harina a la receta (ej. 500g por pastel)
POST http://127.0.0.1:3000/recipe
Content-Type: application/json

{
    "product_id": "5a58e5ad-c8e8-4729-bf8f-a8827200fd29",
    "resource_id": "75a0ac56-e139-4254-bb27-b46b23a05a20",
    "quantity": 500
}

### Agregar Huevos a la receta (ej. 4 huevos por pastel)
POST http://127.0.0.1:3000/recipe
Content-Type: application/json

{
    "product_id": "93a488df-66a5-4574-bfaf-bd5db98bc61f",
    "resource_id": "518965d0-fcf0-4757-ada2-48c959efe7ae",
    "quantity": 4
}

### Agregar Chocolate a la receta (ej. 150g por pastel)
POST http://127.0.0.1:3000/recipe
Content-Type: application/json

{
    "product_id": "5a58e5ad-c8e8-4729-bf8f-a8827200fd29",
    "resource_id": "dea40d30-2861-4c61-a8e0-718507e7c326",
    "quantity": 150
}


